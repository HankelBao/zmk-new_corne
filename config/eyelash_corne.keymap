#define ZMK_POINTING_DEFAULT_MOVE_VAL 2000  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 1 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 1 1>; };

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <300>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
    require-prior-idle-ms = <125>;
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
    require-prior-idle-ms = <125>;
};

/ {
    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    // Tab on tap, a modifier on hold (Ctrl; Gui on the MAC layer).
    // "balanced" so Ctrl+key registers as soon as the other key is tapped,
    // without waiting out the tapping term. No require-prior-idle: Ctrl
    // shortcuts must work immediately after typing.
    mod_tab: mod_tab {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "balanced";
        tapping-term-ms = <200>;
        quick-tap-ms = <150>;
        bindings = <&kp>, <&kp>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    macros {
        // Left outer thumb: Gui, plus the APP layer so that Tab can turn the
        // hold into an Alt+Tab app switcher. Releasing the thumb drops
        // everything the switcher may have left held; releasing a modifier
        // that is not held is a no-op in ZMK.
        gui_app: gui_app {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press &kp LGUI &mo 5>,
                <&macro_pause_for_release>,
                <&macro_release &mo 6 &mo 5 &kp LALT &kp LGUI>;
        };

        // First Tab (the key left of A) while the thumb is held: swap Gui for Alt, leave Alt
        // held, and move to the SWITCH layer where Tab is a plain Tab, so
        // further taps keep cycling.
        //
        // Gui and Alt must never be down together: Android toggles Caps Lock
        // when a Gui+Alt chord is released. Gui must not look like a bare
        // tap either, since that opens the launcher/assistant. So tap right
        // Ctrl first (any non-Gui key cancels the bare-tap action), then
        // release Gui, and only then bring Alt down.
        app_first: app_first {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap &kp RCTRL>,
                <&macro_release &kp LGUI>,
                <&macro_press &kp LALT &mo 6>,
                <&macro_tap &kp TAB>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E     &kp R  &kp T                                    &msc SCRL_DOWN                   &kp Y        &kp U  &kp I      &kp O    &kp P     &kp BSPC
&mod_tab LCTRL TAB  &kp A  &kp S  &kp D  &kp F  &kp G                  &msc SCRL_LEFT  &mkp MCLK       &msc SCRL_RIGHT  &kp H        &kp J  &kp K      &kp L    &kp SEMI  &lt 4 SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp C_MUTE                    &msc SCRL_UP                     &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH  &mo 3
                         &gui_app  &mo 3  &kp ENTER                                              &kp SPACE  &mo 2  &kp LALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        mac_layer {
            display-name = "MAC";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&mod_tab LGUI TAB  &trans  &trans  &trans  &trans  &trans                  &trans          &trans          &trans           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans                          &trans  &trans  &trans  &trans  &trans  &trans
                        &kp LCTRL  &trans  &trans                                                &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
&kp GRAVE  &kp EXCL    &kp AT      &kp HASH    &kp DLLR  &kp PRCNT                                      &trans                          &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &trans
&trans     &kp N1      &kp N2      &kp N3      &kp N4    &kp N5                       &trans          &trans          &trans           &kp N6     &kp N7    &kp N8     &kp N9    &kp N0    &kp EQUAL
&trans     &kp MINUS   &kp PLUS    &kp UNDER   &kp BSLH  &kp PIPE        &kp C_MUTE                    &trans                          &none      &kp LBRC  &kp RBRC   &kp LBKT  &kp RBKT  &trans
                                         &trans        &trans        &trans                                                                          &trans     &trans    &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        raise_layer {
            display-name = "NAV";
            bindings = <
&trans       &kp LG(N1)  &kp LG(N2)      &kp LG(N3)      &kp LG(N4)       &kp LG(N5)                                 &trans                          &none  &none     &none     &kp UP        &none          &kp DEL
&kp LC(TAB)  &trans      &trans          &trans          &trans           &trans                  &trans         &trans          &trans           &none  &kp HOME  &kp LEFT  &kp RIGHT     &kp END        &none
&trans       &trans      &trans          &trans          &trans           &trans      &trans                        &trans                          &none  &none     &kp DOWN  &kp LC(LEFT)  &kp LC(RIGHT)  &trans
                                         &trans          &trans           &trans                                                                    &trans  &trans  &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            display-name = "Fn";
            bindings = <
&soft_off       &kp F1      &kp F2        &kp F3        &kp F4        &kp F5                                  &trans                          &kp F10    &kp F7  &kp F8  &kp F9  &kp F11          &kp F12
&bt BT_CLR_ALL  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                &trans          &trans          &trans           &tog 1     &kp F4  &kp F5  &kp F6  &kp PRINTSCREEN  &trans
&kp CAPS        &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_HUI  &kp C_MUTE                    &trans                          &none      &kp F1  &kp F2  &kp F3  &bootloader      &sys_reset
                                       &trans       &trans     &trans                                                                   &trans     &trans  &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        app_layer {
            display-name = "APP";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&app_first  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        switch_layer {
            display-name = "SWITCH";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };
    };
};
